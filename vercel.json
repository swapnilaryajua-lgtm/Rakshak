{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web-frontend && npm install && npm run build",
  "outputDirectory": "web-frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "web-backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
